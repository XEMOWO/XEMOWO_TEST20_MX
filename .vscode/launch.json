{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32F103 (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],
            "device": "STM32F103CB",
            "gdbPath": "arm-none-eabi-gdb",
            "toolchainPrefix": "arm-none-eabi",
            "svdFile": "",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        }
    ]
}
